[Unit]
Description=AgriSense FastAPI Production Service
After=network.target

[Service]
Type=simple
User=agrisense
WorkingDirectory=/opt/agrisense/backend
EnvironmentFile=/opt/agrisense/backend/.env
ExecStart=/opt/agrisense/backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 4
Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
